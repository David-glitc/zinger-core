# ── Core ────────────────────────────────────────────────────────────
PORT=3000
SITE_URL=http://localhost:3000

# Optional: override runtime data directory (default: ./data)
# ZINGER_DATA_DIR=/var/lib/zinger/data
# ZINGER_INSTANCE=experiment

# Operator browser login (required for Core dashboard)
AUTH_PASSWORD=change-me
# Optional HMAC secret for session cookies (derived from AUTH_PASSWORD if empty)
AUTH_SECRET=

# ── LLM / governor (optional) ───────────────────────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free

# ── Telegram command center (optional) ──────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_DISABLED=1

# ── Polymarket CLOB ─────────────────────────────────────────────────
# CLOB_API_URL=https://clob.polymarket.com
# Optional SOCKS/HTTP egress for order writes (user:pass@host:port)
# CLOB_PROXY_URL=
# Optional HTTPS write relay if you run your own proxy service
# CLOB_PROXY_API_URL=

# Polygon RPC (deposits / reads)
# POLYGON_RPC_URL=https://1rpc.io/matic

# Optional Python binary override for ML pipeline / fallback
# ZINGER_ML_PYTHON=.venv/bin/python3

# ── Frontend (Vite build-time) ──────────────────────────────────────
# VITE_WC_PROJECT_ID=
